@page "/"
@rendermode InteractiveServer
@using Concierge.Web.Components.Shared

<PageTitle>Hotel ZGY Concierge</PageTitle>

<div class="page-shell">
    @if (showEndConfirmation || chatEnded)
    {
        <main class="end-flow-main">
            <section class="end-flow-shell">
                <header class="end-flow-header">
                    <a class="hotel-brand" href="/" aria-label="Hotel ZGY Miami">
                        <strong>Hotel ZGY</strong><span>/ Miami</span>
                    </a>
                    <label class="theme-picker compact-theme-picker">
                        <span class="visually-hidden">Theme</span>
                        <select aria-label="Color theme" value="@theme" @onchange="ChangeThemeAsync">
                            <option value="system">System</option>
                            <option value="light">Light</option>
                            <option value="dark">Dark</option>
                        </select>
                    </label>
                </header>
                <section class="end-state-card" role="@(showEndConfirmation ? "alertdialog" : "status")"
                         aria-modal="@(showEndConfirmation ? "true" : null)"
                         aria-labelledby="end-state-title" aria-describedby="end-state-description">
                    <span class="wave-icon end-wave-icon" aria-hidden="true">
                        <svg viewBox="0 0 32 24" focusable="false">
                            <path d="M2 9c4.7 0 4.7-5 9.3-5s4.7 5 9.4 5S25.4 4 30 4M2 18c4.7 0 4.7-5 9.3-5s4.7 5 9.4 5 4.7-5 9.3-5" />
                        </svg>
                    </span>
                    <h1 id="end-state-title">@(chatEnded ? "Chat ended" : "End this chat?")</h1>
                    <p id="end-state-description">
                        @(chatEnded
                            ? "Your stay conversation history has not been deleted. Verify your stay again to resume while eligible."
                            : "This ends your current interaction, not your stay conversation history. You can verify your stay again to resume while eligible.")
                    </p>

                    @if (showEndConfirmation && !string.IsNullOrWhiteSpace(endError))
                    {
                        <div class="inline-error end-error" role="alert">
                            <span class="error-symbol" aria-hidden="true">!</span>
                            <span>@endError</span>
                        </div>
                    }

                    @if (chatEnded)
                    {
                        <button class="primary-button end-flow-primary" type="button" @onclick="VerifyStayAgain">
                            Verify stay again
                        </button>
                    }
                    else
                    {
                        <button class="primary-button end-flow-primary" type="button"
                                @onclick="EndInteractionAsync" disabled="@isEnding">
                            @(isEnding ? "Ending…" : "End chat")
                        </button>
                        <button class="secondary-button end-flow-secondary" type="button"
                                @onclick="CancelEndChat" disabled="@isEnding">
                            Keep chatting
                        </button>
                    }
                </section>
            </section>
        </main>
    }
    else
    {
        <header class="site-header @(session?.Credential is not null ? "voice-site-header" : "")">
            <a class="hotel-brand" href="/" aria-label="Hotel ZGY Miami">
                <strong>Hotel ZGY</strong><span>/ Miami</span>
            </a>
            <div class="header-actions voice-header-actions">
                @if (voiceMode)
                {
                    <div class="voice-status voice-@voiceState @(voiceMuted ? "is-muted" : "")"
                         role="status" aria-live="polite" title="@voiceMessage">
                        <span class="voice-indicator" aria-hidden="true"></span>
                        <strong>@(voiceMuted ? "Muted" : VoiceStateLabel)</strong>
                    </div>
                }
                <div class="voice-header-controls" role="group" aria-label="Chat controls">
                    @if (voiceMode)
                    {
                        if (VoiceActive)
                        {
                            <button class="voice-control-button" type="button"
                                    aria-label="Mute microphone" aria-pressed="@(voiceMuted ? "true" : "false")"
                                    @onclick="ToggleVoiceMuteAsync">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <rect x="9" y="2" width="6" height="12" rx="3" />
                                    <path d="M5 10v2a7 7 0 0 0 14 0v-2M12 19v3M8 22h8" />
                                    @if (voiceMuted)
                                    {
                                        <path d="m3 3 18 18" />
                                    }
                                </svg>
                                <span>@(voiceMuted ? "Unmute" : "Mute")</span>
                            </button>
                        }
                        else if (voiceState == "paused")
                        {
                            <button class="voice-control-button" type="button" aria-label="Resume voice" @onclick="ResumeVoiceAsync">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="m8 4 12 8-12 8Z" />
                                </svg>
                                <span>Resume</span>
                            </button>
                        }
                        else
                        {
                            <button class="voice-control-button" type="button" aria-label="Reconnect voice" @onclick="ConnectVoiceAsync">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M20 7v5h-5M20 12a8 8 0 1 0-2 5M20 7l-3-3" />
                                </svg>
                                <span>Reconnect</span>
                            </button>
                        }
                    }
                    else if (session?.Credential is not null && !hasExpired)
                    {
                        <button class="voice-control-button" type="button" @onclick="StartVoiceAsync" disabled="@(!CanStartVoice)">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <rect x="9" y="2" width="6" height="12" rx="3" />
                                <path d="M5 10v2a7 7 0 0 0 14 0v-2M12 19v3M8 22h8" />
                            </svg>
                            <span>Start voice</span>
                        </button>
                    }
                    @if (session?.Credential is not null)
                    {
                        @if (voiceMode)
                        {
                            <button class="voice-end-voice-button" type="button" aria-label="End voice"
                                    @onclick="EndVoiceAsync">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M12 3v18M5 8v8M19 8v8M2 10v4M22 10v4" />
                                </svg>
                                <span>End voice</span>
                            </button>
                        }
                        <button class="end-chat-button voice-end-chat-button" type="button" aria-label="End chat"
                                @onclick="EndChatAsync" disabled="@isEnding">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                <path d="m6 6 12 12M18 6 6 18" />
                            </svg>
                            <span>End chat</span>
                        </button>
                    }
                    <label class="theme-picker compact-theme-picker">
                        <span class="visually-hidden">Theme</span>
                        <svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <circle cx="12" cy="12" r="4" />
                            <path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5l1.5 1.5M5 19l1.5-1.5M17.5 6.5 19 5" />
                        </svg>
                        <select aria-label="Color theme" value="@theme" @onchange="ChangeThemeAsync">
                            <option value="system">System</option>
                            <option value="light">Light</option>
                            <option value="dark">Dark</option>
                        </select>
                    </label>
                </div>
            </div>
        </header>

        <main class="main-content @(ready && session?.Credential is null ? "verification-main" : "")">
            @if (!ready)
            {
                <div class="startup-message" role="status">Preparing your chat…</div>
            }
            else if (session?.Credential is null)
            {
                <section class="verification-card" aria-labelledby="verify-title">
                    <span class="wave-icon verification-wave-icon" aria-hidden="true">
                        <svg viewBox="0 0 32 24" focusable="false">
                            <path d="M2 9c4.7 0 4.7-5 9.3-5s4.7 5 9.4 5S25.4 4 30 4M2 18c4.7 0 4.7-5 9.3-5s4.7 5 9.4 5 4.7-5 9.3-5" />
                        </svg>
                    </span>
                    <h1 id="verify-title">Verify your stay</h1>
                    <p class="verification-intro">Enter your last name and room number to continue.</p>
                    @if (!string.IsNullOrWhiteSpace(verificationError))
                    {
                        <div class="inline-error verification-error" role="alert">
                            <span class="error-symbol" aria-hidden="true">!</span>
                            <span>@verificationError</span>
                        </div>
                    }
                    <form class="verification-form" @onsubmit="VerifyAsync" @onsubmit:preventDefault>
                        <label for="last-name">Last name</label>
                        <input id="last-name" type="text" placeholder="Last name"
                               autocomplete="family-name" maxlength="100" @bind="lastName" />
                        <label for="room-number">Room number</label>
                        <input id="room-number" type="text" placeholder="Room number"
                               inputmode="numeric" autocomplete="off" maxlength="4" @bind="roomNumber" />
                        <p class="field-hint">Enter the room number exactly as provided.</p>
                        <button class="primary-button verify-button" type="submit" disabled="@isVerifying">
                            @(isVerifying ? "Verifying…" : "Verify and continue")
                        </button>
                    </form>
                </section>
            }
            else
            {
                <section class="chat-panel" aria-label="Hotel concierge chat">
                    <button class="questions-heading" type="button" aria-expanded="@suggestionsExpanded"
                            aria-controls="suggested-question-content" @onclick="ToggleSuggestions">
                        <span class="wave-icon questions-wave-icon" aria-hidden="true">
                            <svg viewBox="0 0 32 24" focusable="false">
                                <path d="M2 9c4.7 0 4.7-5 9.3-5s4.7 5 9.4 5S25.4 4 30 4M2 18c4.7 0 4.7-5 9.3-5s4.7 5 9.4 5 4.7-5 9.3-5" />
                            </svg>
                        </span>
                        <span>How can we help?</span>
                        <svg class="accordion-chevron @(suggestionsExpanded ? "is-expanded" : "")"
                             viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="m6 9 6 6 6-6" />
                        </svg>
                    </button>
                    <section id="suggested-question-content" class="suggestions"
                             aria-label="Suggested questions" hidden="@(!suggestionsExpanded)">
                        <label for="suggestion-select">Suggested question</label>
                        <select id="suggestion-select" @bind="selectedSuggestion"
                                disabled="@(isWorking || pending is not null || hasExpired)">
                            <option value="">Choose a suggested question…</option>
                            @foreach (var suggestion in Suggestions)
                            {
                                <option value="@suggestion">@suggestion</option>
                            }
                        </select>
                        <div class="suggestion-footer">
                            <p>Choose a question, then send it.</p>
                            <button class="suggestion-send" type="button"
                                    @onclick="SendSuggestionAsync"
                                    disabled="@(isWorking || pending is not null || hasExpired || string.IsNullOrWhiteSpace(selectedSuggestion))">
                                Send suggestion
                            </button>
                        </div>
                    </section>

                    <div class="conversation-heading">
                        <span>YOUR STAY CONVERSATION</span>
                    </div>
                    <div class="transcript-wrap">
                        <div class="transcript" @ref="transcriptElement" aria-label="Stay conversation">
                            @{
                                DateOnly? previousDay = null;
                            }
                            @foreach (var message in Messages)
                            {
                                if (previousDay != message.HotelDay)
                                {
                                    <div class="date-separator">
                                        <span>@message.HotelDay.ToString("MMM dd", System.Globalization.CultureInfo.InvariantCulture)</span>
                                    </div>
                                    previousDay = message.HotelDay;
                                }
                                <div class="message-row @(message.IsGuest ? "guest-row" : "concierge-row")">
                                    <div class="message-content">
                                        <div class="message-meta">
                                            <strong>@(message.IsGuest ? "GUEST" : "CONCIERGE")</strong>
                                            <time datetime="@message.Timestamp.ToString("O")">
                                                @message.Timestamp.ToString("h:mm tt", System.Globalization.CultureInfo.InvariantCulture)
                                            </time>
                                        </div>
                                        <div class="message-bubble @(message.IsGuest ? "guest-bubble" : "concierge-bubble")">
                                            @if (message.IsGuest)
                                            {
                                                @message.Text
                                            }
                                            else
                                            {
                                                <AssistantResponse Text="@message.Text" />
                                                @if (message.Interrupted)
                                                {
                                                    <span class="interrupted-indicator">Interrupted</span>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (pending is not null && isWorking)
                            {
                                <div class="reply-pending" role="status" aria-live="polite">
                                    <span class="pending-dot" aria-hidden="true"></span>
                                    Preparing a reply…
                                </div>
                            }
                        </div>
                        @if (showNewMessage)
                        {
                            <button class="new-message-button" type="button" @onclick="ScrollToLatestAsync">
                                New message ↓
                            </button>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(turnError))
                    {
                        <div class="turn-error" role="alert">
                            <div>
                                <strong>We couldn’t send that message.</strong>
                                <p>@turnError</p>
                            </div>
                            @if (pending is not null)
                            {
                                <button class="retry-button" type="button" @onclick="RetryAsync" disabled="@isWorking">
                                    Retry
                                </button>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(endError))
                    {
                        <div class="turn-error" role="alert">
                            <div>
                                <strong>We couldn’t end the chat.</strong>
                                <p>@endError</p>
                            </div>
                        </div>
                    }

                    @if (showExpiredStrip || hasExpired)
                    {
                        <div class="session-expired" role="status">
                            <span class="expired-icon" aria-hidden="true">!</span>
                            <div class="expired-copy">
                                <strong>Session expired</strong>
                                <span>Sign in again to continue. Your messages remain here.</span>
                                <small>If your stay has ended, contact the front desk.</small>
                            </div>
                            <button type="button" class="sign-in-again-button" @onclick="VerifyAgain">
                                Sign in again <span aria-hidden="true">↗</span>
                            </button>
                        </div>
                    }

                    <form class="composer" @onsubmit="SendDraftAsync" @onsubmit:preventDefault>
                        <label class="message-label" for="message-draft">MESSAGE</label>
                        <div class="compose-box">
                            <textarea id="message-draft" placeholder="Type a message…"
                                      rows="3" maxlength="2000"
                                      @bind="draft" @bind:event="oninput" @bind:after="PersistDraftAsync"
                                      disabled="@hasExpired"></textarea>
                            <div class="compose-footer">
                                @if (hasExpired)
                                {
                                    <span class="composer-hint">Sign in again before sending.</span>
                                }
                                <button class="primary-button send-button" type="submit"
                                        aria-label="Send message"
                                        disabled="@(isWorking || pending is not null || hasExpired || string.IsNullOrWhiteSpace(draft))">
                                    <span>Send</span>
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                        <path d="m4 4 17 8-17 8 3-8-3-8Zm3 8h14" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </form>
                </section>
            }
        </main>
    }
</div>
