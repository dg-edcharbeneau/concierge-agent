@*
    The single centered card used by the verification view and the end-of-chat
    views: wave icon, title, description, then caller-supplied body content.
    Unmatched attributes (role, aria-modal, aria-labelledby, …) splat onto the card.
*@
<section class="focus-card @Modifier" @attributes="Attributes">
    <span class="wave-icon focus-card-icon" aria-hidden="true">
        <svg viewBox="0 0 32 24" focusable="false">
            <path d="M2 9c4.7 0 4.7-5 9.3-5s4.7 5 9.4 5S25.4 4 30 4M2 18c4.7 0 4.7-5 9.3-5s4.7 5 9.4 5 4.7-5 9.3-5" />
        </svg>
    </span>
    <h1 id="@TitleId">@Title</h1>
    <p id="@DescriptionId" class="focus-card-intro">@Description</p>
    @ChildContent
</section>

@code {
    /// <summary>Optional modifier class, such as the narrower centered end-state card.</summary>
    [Parameter]
    public string? Modifier { get; set; }

    /// <summary>Heading text.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Identifier for the heading so callers can label the card with it.</summary>
    [Parameter]
    public string? TitleId { get; set; }

    /// <summary>Description shown under the heading.</summary>
    [Parameter, EditorRequired]
    public string Description { get; set; } = string.Empty;

    /// <summary>Identifier for the description so callers can describe the card with it.</summary>
    [Parameter]
    public string? DescriptionId { get; set; }

    /// <summary>Card body: the verification form, or the end-of-chat error and actions.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Accessibility and other attributes applied to the card element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? Attributes { get; set; }
}
