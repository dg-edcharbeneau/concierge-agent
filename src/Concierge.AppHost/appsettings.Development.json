      "Provider": "Ollama",
      "Endpoint": "http://127.0.0.1:11434",
      "Model": "embeddinggemma-2:740m",
      "RequestTimeoutSeconds": 8,
      "MaxConcurrentRequests": 2
    }
  }
}
